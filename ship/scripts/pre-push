#!/bin/sh
# Ship check: block a push whose commits had no ship interview; record <git-common-dir>/ship/<branch> starts "head <sha>"; SHIP_SKIP=1 skips one push.

dir="$(git rev-parse --git-common-dir)/ship" || exit 1

if [ "${SHIP_SKIP:-}" = 1 ]; then
  echo "ship: interview check skipped (SHIP_SKIP=1)" >&2
  exit 0
fi

base=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) || base=origin/main

# Patch id of a branch tip against the default branch; the same change after a rebase keeps it.
patch_id() {
  mb=$(git merge-base "$base" "$1" 2>/dev/null) || return 1
  git diff "$mb" "$1" | git patch-id --stable | cut -d' ' -f1
}

hint="Run the ship interview, or push with SHIP_SKIP=1 to skip it once."
status=0

while read -r lref lsha rref rsha; do
  # The remote ref says what is being updated; the local ref can be HEAD or a commit.
  case "$rref" in refs/heads/*) ;; *) continue ;; esac
  case "$lsha" in *[!0]*) ;; *) continue ;; esac
  case "$lref" in
    refs/heads/*) branch=${lref#refs/heads/} ;;
    HEAD) branch=$(git symbolic-ref -q --short HEAD) || branch=${rref#refs/heads/} ;;
    *) branch=${rref#refs/heads/} ;;
  esac
  rec="$dir/$branch"

  if [ ! -f "$rec" ]; then
    echo "ship: no ship interview for $branch. $hint" >&2
    status=1
    continue
  fi

  head=$(sed -n 's/^head //p' "$rec")
  [ "$head" = "$lsha" ] && continue

  if [ -n "$head" ] && git merge-base --is-ancestor "$head" "$lsha" 2>/dev/null; then
    n=$(git rev-list --count "$head..$lsha")
    echo "ship: $n commit(s) on $branch since the last ship interview:" >&2
    git log --oneline "$head..$lsha" >&2
    echo "$hint" >&2
    status=1
    continue
  fi

  old=$(patch_id "$head") && new=$(patch_id "$lsha")
  if [ -n "$old" ] && [ "$old" = "$new" ]; then
    printf 'head %s\ndate %s\n' "$lsha" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$rec"
    echo "ship: $branch was rewritten with the same change; record moved to ${lsha%"${lsha#???????}"}" >&2
    continue
  fi

  echo "ship: $branch was rewritten and the change differs from the last ship interview. $hint" >&2
  status=1
done

exit $status
